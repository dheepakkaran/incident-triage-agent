# Copy to .env and fill in what you have. Every value has a working default.

# Providers are tried in this order. Providers without a key are skipped.
LLM_PROVIDER_CHAIN=groq,google,openrouter,ollama

# Each agent can use its own provider chain. Scout (investigator) on Groq, Skeptic (reviewer) on
# Google's Gemma 4, a different model family, so the review is a more independent second opinion.
INVESTIGATOR_PROVIDER_CHAIN=groq,ollama
REVIEWER_PROVIDER_CHAIN=google,groq,ollama

# Free keys: https://console.groq.com/keys, https://aistudio.google.com/apikey, https://openrouter.ai/keys
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Model names (open-weight, tool calling). Check provider docs if one is retired.
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
GOOGLE_MODEL=gemma-4-31b-it
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434

# Agent limits
MAX_TOOL_CALLS=8
CONFIDENCE_THRESHOLD=0.6
# Off by default: the dev ablation did not meet the bar to keep it on (see README). The demo turns it on.
REVIEWER_ENABLED=false
REVIEWER_MAX_TOOL_CALLS=3

# Disk cache for LLM calls, so eval reruns do not spend free-tier quota again
LLM_CACHE_ENABLED=true

# Local embedding model for runbook search (small, CPU is fine)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
